# Server-side AI keys (supports comma-separated lists or numbered *_1, *_2 entries for automatic rotation)
GEMINI_API_KEY=

# Server-side live data feed keys & app ID (supports comma-separated lists or numbered *_1, *_2 entries for rotation)
RAPIDAPI_KEY=
RAPIDAPI_APP_ID=

# Google Maps Platform API key (rotated via /api/maps/client-config when multiple keys are supplied)
VITE_GOOGLE_MAPS_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
