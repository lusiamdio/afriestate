# Server-side Gemini API key (accessed by server.ts, never exposed to browser)
GEMINI_API_KEY=

# Server-side RapidAPI key & application ID for AeroDataBox, Booking.com, TripAdvisor, Google Flights, Visa Map, and Safety Index
RAPIDAPI_KEY=
RAPIDAPI_APP_ID=

# Browser-side Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
