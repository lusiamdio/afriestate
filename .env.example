# Server-side AI keys (supports comma-separated lists or numbered *_1, *_2 entries for automatic rotation)
GEMINI_API_KEY=

# Server-side live data feed keys & app ID (supports comma-separated lists or numbered *_1, *_2 entries for rotation)
RAPIDAPI_KEY=
RAPIDAPI_APP_ID=
VISA_API_KEY_1=
VISA_API_KEY_2=

# Google Maps Platform API key (rotated via /api/maps/client-config when multiple keys are supplied)
VITE_GOOGLE_MAPS_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side Web3 / Alchemy RPC URLs & API keys (supports comma-separated lists or *_1, *_2 rotation)
ALCHEMY_RPC_URL=
ALCHEMY_API_KEY=

# Optional server-side MailerLite, Twilio, MeetingBaas & Password Pusher secrets (supports *_1, *_2 rotation)
MAILERLITE_API_KEY=
TWILIO_API_KEY=
TWILIO_ACCOUNT_SID=
MEETINGBAAS_API_KEY=
PWPUSH_URL=

# Alternative OpenRouter & OpenAI-compatible AI APIs (automatic failover/alternative to Gemini; supports *_1, *_2 or comma-separated rotation)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
AI_API_KEYS=
AI_API_BASE_URL=
AUTHENTICATION_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional server-side Visa Developer / Visa Direct / Checkout Gateway credentials (never commit secrets)
VISA_DEVELOPER_USER_ID=
VISA_DEVELOPER_PASSWORD=
VISA_DIRECT_API_KEY=
VISA_GATEWAY_URL=
